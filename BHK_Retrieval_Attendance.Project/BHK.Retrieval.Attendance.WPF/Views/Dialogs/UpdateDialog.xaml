<Window x:Class="BHK.Retrieval.Attendance.WPF.Views.Dialogs.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Cập nhật phần mềm"
        Height="400"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="Update" 
                                    Width="48" 
                                    Height="48"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            
            <TextBlock Text="Đã có phiên bản mới!"
                      Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                      HorizontalAlignment="Center"
                      Margin="0,10,0,0"/>
            
            <TextBlock HorizontalAlignment="Center"
                      Margin="0,5,0,0">
                <Run Text="Phiên bản mới: "/>
                <Run Text="{Binding NewVersion}" 
                     FontWeight="Bold"
                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            </TextBlock>
        </StackPanel>

        <!-- Release Notes -->
        <GroupBox Grid.Row="1" 
                 Header="Ghi chú phát hành"
                 Style="{StaticResource MaterialDesignCardGroupBox}"
                 Margin="0,0,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         MaxHeight="150">
                <TextBlock Text="{Binding ReleaseNotes}"
                          TextWrapping="Wrap"
                          Padding="10"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Progress Section -->
        <StackPanel Grid.Row="2" 
                   Margin="0,0,0,20"
                   Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,10"/>
            
            <ProgressBar Value="{Binding DownloadProgress}"
                        Maximum="100"
                        Height="6"
                        IsIndeterminate="{Binding IsDownloading}"/>
        </StackPanel>

        <!-- Status Message (when not downloading) -->
        <TextBlock Grid.Row="2"
                  Text="{Binding StatusMessage}"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,20"
                  Foreground="{DynamicResource SecondaryHueMidBrush}"
                  Visibility="{Binding IsDownloading, Converter={StaticResource InverseBoolToVisibility}}"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Center">
            <Button Content="CẬP NHẬT NGAY"
                   Command="{Binding UpdateNowCommand}"
                   IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}"
                   Style="{StaticResource MaterialDesignRaisedButton}"
                   Width="150"
                   Margin="0,0,10,0"/>
            
            <Button Content="ĐỂ SAU"
                   Command="{Binding UpdateLaterCommand}"
                   IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}"
                   Style="{StaticResource MaterialDesignOutlinedButton}"
                   Width="150"
                   Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
